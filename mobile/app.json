{
  "expo": {
    "name": "Pick'em Poker",
    "slug": "pickem-poker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "pickem-poker",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pickempoker.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f4eee6"
      },
      "package": "com.pickempoker.app"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-status-bar",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f5f5f0",
          "dark": {
            "backgroundColor": "#1a1611"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      },
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    }
  }
}
